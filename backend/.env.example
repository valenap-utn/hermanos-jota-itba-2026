# Puerto del servidor (en Render se asigna automáticamente mediante la variable PORT)
PORT=3001

# URI de conexión a MongoDB Atlas (producción) o local (desarrollo)
# Formato Atlas: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/hermanos-jota?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/hermanos-jota?retryWrites=true&w=majority

# Límite máximo de productos en catálogo
MAX_PRODUCTOS=25

# Credenciales de Cloudinary para subida y almacenamiento de imágenes
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Configuración JWT
# Generar JWT_SECRET con:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Seed del usuario administrador
# Requeridas únicamente para ejecutar npm run seed:admin
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Entorno de ejecución (development / production)
NODE_ENV=development
